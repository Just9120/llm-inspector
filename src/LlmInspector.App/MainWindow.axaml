<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        x:Class="LlmInspector.App.MainWindow"
        mc:Ignorable="d"
        d:DesignWidth="980"
        d:DesignHeight="900"
        Width="980"
        Height="900"
        MinWidth="760"
        MinHeight="480"
        Title="LLM Inspector">
  <ScrollViewer>
    <Grid Margin="32" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="16">
      <StackPanel Spacing="6">
        <TextBlock FontSize="28" FontWeight="SemiBold" Text="LLM Inspector" />
        <TextBlock Text="Local OpenAI-compatible observation proxy" />
      </StackPanel>

      <Border Grid.Row="1"
              Padding="20"
              Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
              CornerRadius="8">
        <StackPanel Spacing="8">
          <TextBlock FontSize="18" FontWeight="SemiBold" Text="Gateway" />
          <TextBlock x:Name="GatewayStateText" TextWrapping="Wrap" />
          <TextBlock x:Name="ListenerText" TextWrapping="Wrap" />
          <TextBlock x:Name="BackendText" TextWrapping="Wrap" />
          <TextBlock x:Name="BackendKindText" TextWrapping="Wrap" />
          <TextBlock x:Name="ClientEndpointsText" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <Border Grid.Row="2"
              Padding="20"
              Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
              CornerRadius="8">
        <StackPanel Spacing="8">
          <TextBlock FontSize="18" FontWeight="SemiBold" Text="Live requests" />
          <TextBlock x:Name="LiveRequestsText" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <Border Grid.Row="3"
              Padding="20"
              Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
              CornerRadius="8">
        <StackPanel Spacing="8">
          <TextBlock FontSize="18" FontWeight="SemiBold" Text="Latest request details" />
          <TextBlock x:Name="RequestDetailText" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <Border Grid.Row="4"
              Padding="20"
              Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
              CornerRadius="8">
        <StackPanel Spacing="8">
          <TextBlock FontSize="18" FontWeight="SemiBold" Text="Request resource timeline" />
          <TextBlock x:Name="ResourceTelemetryText" TextWrapping="Wrap" />
          <TextBlock Text="Process metrics are shown only for an exact Windows listener-owner association; unsupported sources remain unavailable."
                     TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <Border Grid.Row="5"
              Padding="20"
              Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
              CornerRadius="8">
        <StackPanel Spacing="8">
          <TextBlock FontSize="18" FontWeight="SemiBold" Text="Technical data and retention" />
          <TextBlock x:Name="TechnicalDataText" TextWrapping="Wrap" />
          <TextBlock x:Name="PersistentDataText" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <Border Grid.Row="6"
              Padding="20"
              Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
              CornerRadius="8">
        <StackPanel Spacing="10">
          <TextBlock FontSize="18" FontWeight="SemiBold" Text="History and analytics" />
          <TextBlock x:Name="HistoryStateText" TextWrapping="Wrap" />

          <TextBlock FontWeight="SemiBold" Text="History filters" />
          <WrapPanel Orientation="Horizontal">
            <TextBox x:Name="FilterFromText" Width="210" Margin="0,0,8,8" PlaceholderText="From UTC (ISO-8601)" />
            <TextBox x:Name="FilterToText" Width="210" Margin="0,0,8,8" PlaceholderText="To UTC (ISO-8601)" />
            <ComboBox x:Name="FilterClientCombo" Width="150" Margin="0,0,8,8" />
            <ComboBox x:Name="FilterBackendCombo" Width="140" Margin="0,0,8,8" />
            <TextBox x:Name="FilterModelText" Width="170" Margin="0,0,8,8" PlaceholderText="Model" />
            <TextBox x:Name="FilterSessionText" Width="250" Margin="0,0,8,8" PlaceholderText="Session GUID" />
            <ComboBox x:Name="FilterStatusCombo" Width="170" Margin="0,0,8,8" />
            <ComboBox x:Name="FilterErrorCombo" Width="190" Margin="0,0,8,8" />
            <Button x:Name="LoadHistoryButton" Margin="0,0,8,8" Content="Load history" />
            <Button x:Name="LoadAnalyticsButton" Margin="0,0,8,8" Content="Build trends" />
          </WrapPanel>
          <TextBlock x:Name="HistoryOutputText" TextWrapping="Wrap" />
          <TextBlock x:Name="AnalyticsOutputText" TextWrapping="Wrap" />

          <TextBlock FontWeight="SemiBold" Text="Operation detail" />
          <WrapPanel Orientation="Horizontal">
            <TextBox x:Name="OperationIdText" Width="340" Margin="0,0,8,8" PlaceholderText="Operation GUID" />
            <Button x:Name="LoadOperationButton" Margin="0,0,8,8" Content="Load operation" />
          </WrapPanel>
          <TextBlock x:Name="OperationOutputText" TextWrapping="Wrap" />

          <TextBlock FontWeight="SemiBold" Text="Comparison" />
          <TextBlock Text="Period values use start..end; other dimensions use one exact model/backend/client value."
                     TextWrapping="Wrap" />
          <WrapPanel Orientation="Horizontal">
            <ComboBox x:Name="ComparisonDimensionCombo" Width="130" Margin="0,0,8,8" />
            <ComboBox x:Name="ComparisonMetricCombo" Width="240" Margin="0,0,8,8" />
            <TextBox x:Name="ComparisonBaselineText" Width="260" Margin="0,0,8,8" PlaceholderText="Baseline selection" />
            <TextBox x:Name="ComparisonCandidateText" Width="260" Margin="0,0,8,8" PlaceholderText="Candidate selection" />
            <Button x:Name="CompareButton" Margin="0,0,8,8" Content="Compare" />
          </WrapPanel>
          <TextBlock x:Name="ComparisonOutputText" TextWrapping="Wrap" />

          <TextBlock FontWeight="SemiBold" Text="Retention" />
          <WrapPanel Orientation="Horizontal">
            <ComboBox x:Name="RetentionCombo" Width="180" Margin="0,0,8,8" />
            <Button x:Name="ApplyRetentionButton" Margin="0,0,8,8" Content="Save and apply" />
          </WrapPanel>
          <TextBlock x:Name="RetentionOutputText" TextWrapping="Wrap" />

          <TextBlock FontWeight="SemiBold" Text="Clear local history" />
          <WrapPanel Orientation="Horizontal">
            <CheckBox x:Name="ClearAllCheckBox" Margin="0,0,8,8" Content="All history" />
            <TextBox x:Name="ClearFromText" Width="210" Margin="0,0,8,8" PlaceholderText="From UTC (ISO-8601)" />
            <TextBox x:Name="ClearToText" Width="210" Margin="0,0,8,8" PlaceholderText="To UTC (ISO-8601)" />
            <Button x:Name="PreviewClearButton" Margin="0,0,8,8" Content="Preview clear" />
            <Button x:Name="ConfirmClearButton" Margin="0,0,8,8" Content="Confirm exact preview" IsEnabled="False" />
          </WrapPanel>
          <TextBlock x:Name="ClearOutputText" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <Border Grid.Row="7"
              Padding="20"
              Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
              CornerRadius="8">
        <StackPanel Spacing="8">
          <TextBlock FontSize="18" FontWeight="SemiBold" Text="Diagnostics" />
          <TextBlock x:Name="DiagnosticsSummaryText" TextWrapping="Wrap" />
          <TextBlock Text="This surface reports only technical state; prompt, response, reasoning and tool content are excluded."
                     TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <Border Grid.Row="8"
              Padding="20"
              Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
              CornerRadius="8">
        <StackPanel Spacing="8">
          <TextBlock FontSize="18" FontWeight="SemiBold" Text="Anonymized diagnostic snapshot" />
          <TextBlock Text="Schema diagnostic-snapshot-v1 contains only the documented technical allowlist. Preview is required before saving; the app never uploads the file."
                     TextWrapping="Wrap" />
          <WrapPanel Orientation="Horizontal">
            <ComboBox x:Name="SnapshotScopeCombo" Width="150" Margin="0,0,8,8" />
            <TextBox x:Name="SnapshotFromText" Width="210" Margin="0,0,8,8" PlaceholderText="From UTC (ISO-8601)" />
            <TextBox x:Name="SnapshotToText" Width="210" Margin="0,0,8,8" PlaceholderText="To UTC (ISO-8601)" />
            <TextBox x:Name="SnapshotOperationIdText" Width="280" Margin="0,0,8,8" PlaceholderText="Operation GUID" />
          </WrapPanel>
          <TextBox x:Name="SnapshotPathText" PlaceholderText="Local .json output path" />
          <WrapPanel Orientation="Horizontal">
            <Button x:Name="PreviewSnapshotButton" Margin="0,0,8,8" Content="Create local preview" />
            <Button x:Name="SaveSnapshotButton" Margin="0,0,8,8" Content="Save exact preview" IsEnabled="False" />
          </WrapPanel>
          <TextBlock x:Name="SnapshotStateText" TextWrapping="Wrap" />
          <TextBox x:Name="SnapshotPreviewText"
                   MinHeight="180"
                   AcceptsReturn="True"
                   IsReadOnly="True"
                   TextWrapping="NoWrap"
                   PlaceholderText="Previewed JSON appears here" />
        </StackPanel>
      </Border>

      <Border Grid.Row="9"
              Padding="20"
              Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
              CornerRadius="8">
        <StackPanel Spacing="8">
          <TextBlock FontSize="18" FontWeight="SemiBold" Text="Anonymized analytics export" />
          <TextBlock Text="Schema analytics-export-v1 contains selected-range technical history and aggregate metrics. Preview is required before local save; content fields are excluded and nothing is uploaded."
                     TextWrapping="Wrap" />
          <WrapPanel Orientation="Horizontal">
            <TextBox x:Name="ExportFromText" Width="210" Margin="0,0,8,8" PlaceholderText="From UTC (ISO-8601)" />
            <TextBox x:Name="ExportToText" Width="210" Margin="0,0,8,8" PlaceholderText="To UTC (ISO-8601)" />
          </WrapPanel>
          <TextBox x:Name="ExportPathText" PlaceholderText="Local .json output path" />
          <WrapPanel Orientation="Horizontal">
            <Button x:Name="PreviewExportButton" Margin="0,0,8,8" Content="Create export preview" />
            <Button x:Name="SaveExportButton" Margin="0,0,8,8" Content="Save exact export" IsEnabled="False" />
          </WrapPanel>
          <TextBlock x:Name="ExportStateText" TextWrapping="Wrap" />
          <TextBox x:Name="ExportPreviewText"
                   MinHeight="180"
                   AcceptsReturn="True"
                   IsReadOnly="True"
                   TextWrapping="NoWrap"
                   PlaceholderText="Previewed analytics JSON appears here" />
        </StackPanel>
      </Border>

      <Border Grid.Row="10"
              Padding="20"
              Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
              CornerRadius="8">
        <StackPanel Spacing="8">
          <TextBlock FontSize="18" FontWeight="SemiBold" Text="Производительность мониторинга" />
          <TextBlock Text="Выберите понятный профиль частоты сбора технических метрик. Сбалансированный профиль рекомендуется большинству пользователей."
                     TextWrapping="Wrap" />
          <ComboBox x:Name="PerformanceProfileCombo" Width="340" HorizontalAlignment="Left" />
          <WrapPanel Orientation="Horizontal">
            <TextBox x:Name="CustomSamplingIntervalText"
                     Width="220"
                     Margin="0,0,8,8"
                     PlaceholderText="Интервал своего профиля, мс" />
            <Button x:Name="ResetPerformanceProfileButton"
                    Margin="0,0,8,8"
                    Content="Вернуть рекомендуемый" />
          </WrapPanel>
          <TextBlock x:Name="PerformanceProfileStateText" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <Border Grid.Row="11"
              Padding="20"
              Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
              CornerRadius="8">
        <StackPanel Spacing="8">
          <TextBlock FontSize="18" FontWeight="SemiBold" Text="Background and notifications" />
          <CheckBox x:Name="AutostartCheckBox" Content="Start LLM Inspector with Windows in background" />
          <TextBlock FontWeight="SemiBold" Text="Notify me when" />
          <CheckBox x:Name="NotifyBackendUnavailableCheckBox" Content="Backend is unavailable" />
          <CheckBox x:Name="NotifyLongOperationCheckBox" Content="A long operation completes" />
          <CheckBox x:Name="NotifyRecurringErrorCheckBox" Content="An error becomes recurring" />
          <CheckBox x:Name="NotifyHighContextCheckBox" Content="Context usage is high" />
          <CheckBox x:Name="SilentNotificationsCheckBox" Content="Silent mode (no notification sound)" />
          <WrapPanel Orientation="Horizontal">
            <Button x:Name="SaveBackgroundSettingsButton" Margin="0,0,8,8" Content="Сохранить настройки" />
          </WrapPanel>
          <TextBlock x:Name="BackgroundSettingsStateText" TextWrapping="Wrap" />
          <TextBlock Text="Anti-spam policy notification-policy-v1: duplicate event key 15 min; at most 3 notifications per rolling 10 min. Tray menu can pause/resume notifications."
                     TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <Border Grid.Row="12"
              Padding="20"
              Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
              CornerRadius="8">
        <StackPanel Spacing="8">
          <TextBlock FontSize="18" FontWeight="SemiBold" Text="Privacy boundary" />
          <TextBlock x:Name="ForbiddenContentText" TextWrapping="Wrap" />
          <TextBlock Text="Request and response bodies are relayed in memory and are not added to technical observations."
                     TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <Border Grid.Row="13"
              Padding="20"
              Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
              CornerRadius="8">
        <StackPanel Spacing="9">
          <TextBlock FontSize="18" FontWeight="SemiBold" Text="Управление локальным backend" />
          <TextBlock Text="Inspector управляет только процессом, который сам запустил после вашего подтверждения exact path, version и loopback endpoint."
                     TextWrapping="Wrap" />
          <WrapPanel Orientation="Horizontal">
            <ComboBox x:Name="LifecycleBackendCombo" Width="190" Margin="0,0,8,8" />
            <TextBox x:Name="LifecycleExecutablePathText"
                     Width="470"
                     Margin="0,0,8,8"
                     PlaceholderText="Полный путь к runtime .exe (необязательно)" />
            <Button x:Name="DiscoverBackendButton" Margin="0,0,8,8" Content="Найти и проверить" />
          </WrapPanel>
          <TextBlock x:Name="LifecycleTargetText" TextWrapping="Wrap" />
          <CheckBox x:Name="ConfirmLifecycleTargetCheckBox"
                    Content="Я проверил точный путь, версию и локальный endpoint" />
          <WrapPanel Orientation="Horizontal">
            <Button x:Name="StartBackendButton" Margin="0,0,8,8" Content="Запустить" />
            <Button x:Name="StopBackendButton" Margin="0,0,8,8" Content="Остановить" />
            <Button x:Name="RestartBackendButton" Margin="0,0,8,8" Content="Перезапустить" />
          </WrapPanel>
          <TextBlock FontWeight="SemiBold" Text="Безопасные параметры" />
          <WrapPanel Orientation="Horizontal">
            <ComboBox x:Name="LifecycleParameterCombo" Width="250" Margin="0,0,8,8" />
            <TextBox x:Name="LifecycleParameterValueText"
                     Width="270"
                     Margin="0,0,8,8"
                     PlaceholderText="Оставьте пустым для native default" />
            <Button x:Name="ApplyLifecycleParameterButton" Margin="0,0,8,8" Content="Сохранить параметр" />
            <Button x:Name="ResetLifecycleParametersButton" Margin="0,0,8,8" Content="Сбросить к defaults" />
          </WrapPanel>
          <TextBlock x:Name="LifecycleParameterHelpText" TextWrapping="Wrap" />
          <TextBlock FontWeight="SemiBold" Text="Модель" />
          <TextBlock Text="Для Ollama/LM Studio укажите model ID; для llama.cpp — полный путь к существующему .gguf."
                     TextWrapping="Wrap" />
          <WrapPanel Orientation="Horizontal">
            <TextBox x:Name="LifecycleModelText" Width="550" Margin="0,0,8,8" PlaceholderText="Model ID или C:\models\model.gguf" />
            <Button x:Name="LoadLifecycleModelButton" Margin="0,0,8,8" Content="Загрузить модель" />
          </WrapPanel>
          <TextBlock x:Name="LifecycleStateText" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <Border Grid.Row="14"
              Padding="20"
              Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
              CornerRadius="8">
        <StackPanel Spacing="9">
          <TextBlock FontSize="18" FontWeight="SemiBold" Text="Защищённый remote access" />
          <TextBlock Text="Inspector всегда слушает только 127.0.0.1. Private HTTPS ingress настраивается вами через Tailscale Serve; Funnel, wildcard bind и публикация backend-порта запрещены."
                     TextWrapping="Wrap" />
          <TextBlock x:Name="TailscaleServeCommandText" TextWrapping="Wrap" FontFamily="Consolas" />
          <TextBlock Text="Tailscale install/login/ACL и Serve остаются явными внешними действиями: Inspector их не выполняет и не меняет. Запросы Serve требуют user identity header и отдельный bearer token."
                     TextWrapping="Wrap" />
          <CheckBox x:Name="RemoteBoundaryConfirmationCheckBox"
                    Content="Я проверил: private HTTPS Serve, user identity, корректный ACL и Funnel выключен" />
          <WrapPanel Orientation="Horizontal">
            <Button x:Name="EnableRemoteAccessButton" Margin="0,0,8,8" Content="Создать token и включить" />
            <Button x:Name="RotateRemoteTokenButton" Margin="0,0,8,8" Content="Ротировать token" />
            <Button x:Name="DisableRemoteAccessButton" Margin="0,0,8,8" Content="Выключить и отозвать token" />
          </WrapPanel>
          <TextBlock x:Name="RemoteAccessStateText" TextWrapping="Wrap" />
          <TextBlock Text="Новый token показывается только при создании/ротации. Скопируйте его в secret storage клиента; Inspector не сможет показать его повторно."
                     TextWrapping="Wrap" />
          <WrapPanel Orientation="Horizontal">
            <TextBox x:Name="RemoteOneTimeTokenText" Width="650" Margin="0,0,8,8" IsReadOnly="True" FontFamily="Consolas" />
            <Button x:Name="HideRemoteTokenButton" Margin="0,0,8,8" Content="Скрыть token" />
          </WrapPanel>
          <TextBlock FontWeight="SemiBold" Text="Remote backend" />
          <TextBlock Text="Availability и DNS+TCP connect latency показываются отдельно. Connect probe не является inference latency; local CPU/RAM/GPU не приписываются remote backend."
                     TextWrapping="Wrap" />
          <Button x:Name="ProbeRemoteBackendButton" HorizontalAlignment="Left" Content="Проверить remote target" />
          <TextBlock x:Name="RemoteBackendStateText" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </Grid>
  </ScrollViewer>
</Window>
