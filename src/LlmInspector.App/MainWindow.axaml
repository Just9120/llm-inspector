<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        x:Class="LlmInspector.App.MainWindow"
        mc:Ignorable="d"
        d:DesignWidth="820"
        d:DesignHeight="620"
        Width="820"
        Height="620"
        MinWidth="620"
        MinHeight="480"
        Title="LLM Inspector">
  <ScrollViewer>
    <Grid Margin="32" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="16">
      <StackPanel Spacing="6">
        <TextBlock FontSize="28" FontWeight="SemiBold" Text="LLM Inspector" />
        <TextBlock Text="Local OpenAI-compatible observation proxy" />
      </StackPanel>

      <Border Grid.Row="1"
              Padding="20"
              Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
              CornerRadius="8">
        <StackPanel Spacing="8">
          <TextBlock FontSize="18" FontWeight="SemiBold" Text="Gateway" />
          <TextBlock x:Name="GatewayStateText" TextWrapping="Wrap" />
          <TextBlock x:Name="ListenerText" TextWrapping="Wrap" />
          <TextBlock x:Name="BackendText" TextWrapping="Wrap" />
          <TextBlock x:Name="BackendKindText" TextWrapping="Wrap" />
          <TextBlock x:Name="ClientEndpointsText" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <Border Grid.Row="2"
              Padding="20"
              Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
              CornerRadius="8">
        <StackPanel Spacing="8">
          <TextBlock FontSize="18" FontWeight="SemiBold" Text="Live requests" />
          <TextBlock x:Name="LiveRequestsText" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <Border Grid.Row="3"
              Padding="20"
              Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
              CornerRadius="8">
        <StackPanel Spacing="8">
          <TextBlock FontSize="18" FontWeight="SemiBold" Text="Technical data and retention" />
          <TextBlock x:Name="TechnicalDataText" TextWrapping="Wrap" />
          <TextBlock x:Name="PersistentDataText" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <Border Grid.Row="4"
              Padding="20"
              Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
              CornerRadius="8">
        <StackPanel Spacing="8">
          <TextBlock FontSize="18" FontWeight="SemiBold" Text="Privacy boundary" />
          <TextBlock x:Name="ForbiddenContentText" TextWrapping="Wrap" />
          <TextBlock Text="Request and response bodies are relayed in memory and are not added to technical observations."
                     TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </Grid>
  </ScrollViewer>
</Window>
