* text=auto

# Preserve shared repository text policies; remove only obsolete C# rules.
.go-version text eol=lf
.node-version text eol=lf
.npm-version text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.ps1 text eol=crlf

# Go/frontend and embedded source bytes must not depend on core.autocrlf.
*.go text eol=lf
go.mod text eol=lf
go.sum text eol=lf
frontend/** text=auto eol=lf
benchmarks/fixtures/** text=auto eol=lf
internal/telemetry/testdata/** text=auto eol=lf
internal/lifecycle/config/** text=auto eol=lf
internal/history/schema/*.sql text eol=lf
build/windows/*.manifest text eol=lf
